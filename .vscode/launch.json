{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GPU OC Service Dev (sudo run.sh --verbose)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd ${workspaceFolder} && sudo ./scripts/run.sh --verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "GPU OC GUI Dev (dev-gui.sh --verbose)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd ${workspaceFolder} && sudo ./scripts/dev-gui.sh --verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}

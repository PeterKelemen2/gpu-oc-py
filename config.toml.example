# GPU OC Configuration
# Copy this file to config.toml and set all values before running.

[profile]
# Index of the GPU to control (0 = first GPU)
gpu_index = 0

# Core clock voltage/frequency offset in MHz
core_offset_mhz = 0

# Power limit in Watts
power_limit_watt = 0

# Maximum core clock to lock to in MHz
max_core_clock_mhz = 0

# Display manager to restart on a driver crash (e.g. "gdm", "sddm", "lightdm").
# Comment out to skip driver/DE reload and rely only on the hardware watchdog.
# display_manager = "gdm"
